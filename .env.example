# Maison Étoile — Environment Configuration Template
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# Copy this file to .env for local development.

# Application Environment
VITE_APP_ENV=development
VITE_APP_TITLE="Maison Étoile | Haute Gastronomie Française"
VITE_APP_URL="http://localhost:5173"

# Reservation Service (Demo Mode by default)
# Set to 'live' only when backed by an authenticated, certified booking provider.
VITE_RESERVATION_MODE=demo
VITE_API_BASE_URL="http://localhost:3001/api"

# Security & Analytics (Strictly opt-in, disabled in demo)
VITE_ENABLE_ANALYTICS=false
VITE_CSP_REPORT_URI=""

# Rate Limiting & Captcha (Production integration placeholders)
VITE_RECAPTCHA_SITE_KEY=""
